{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchy",
  "version": "1.0.2",
  "identifier": "com.laki.patchy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patchy",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 17
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RTczMzVDQTk5MUQ0MkQKUldRdDFKR3BYRFBuZEYyMlJiRnpRNFdJVmFlYVpJYllMSkFOQ0tBbTNlYWw1cjU3ZE9Ed3VrSkcK",
      "endpoints": [
        "https://github.com/lakiAlex/patchy/releases/latest/download/latest.json"
      ]
    }
  }
}
